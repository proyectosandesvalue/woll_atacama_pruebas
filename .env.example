# =====================================================================
# Plataforma Territorial Water Oriented Living Lab Atacama
# Variables de entorno — copia este archivo como .env y completa los
# valores. .env está en .gitignore (NUNCA subirlo al repositorio).
# =====================================================================

# ── Proveedor de base de datos ────────────────────────────────────
# Local/VPS: postgres. Demo Vercel/Supabase: supabase.
DB_DRIVER=postgres

# PostgreSQL propio (Sprint 26).
# El API usa DATABASE_URL (rol woll_api, sin DDL).
# Las migraciones usan DATABASE_ADMIN_URL (rol con DDL).
# En Docker el host es "postgres"; con docker-compose.dev.yml es 127.0.0.1.
POSTGRES_DB=woll
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CAMBIAR
POSTGRES_PORT=5432
DATABASE_URL=postgres://woll_api:CAMBIAR@127.0.0.1:5432/woll
DATABASE_ADMIN_URL=postgres://postgres:CAMBIAR@127.0.0.1:5432/woll
# URL interna para los contenedores api/ingest (host "postgres").
DATABASE_URL_DOCKER=postgres://woll_api:CAMBIAR@postgres:5432/woll
WOLL_API_PASSWORD=CAMBIAR
WOLL_INGEST_PASSWORD=CAMBIAR

# Docker/VPS (26-D).
DOMAIN=visor.example.cl
CERTBOT_EMAIL=admin@example.cl
API_PORT=3000
NGINX_PORT=8080

# Pool y timeouts del driver PostgreSQL (Sprint 26-B).
PG_APPLICATION_NAME=woll-api
PGPOOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=5000
PG_STATEMENT_TIMEOUT_MS=5000
PG_QUERY_TIMEOUT_MS=6000

# Test de integración del driver (se omite si no está definida).
# TEST_DATABASE_URL=postgres://postgres:CAMBIAR@127.0.0.1:5432/woll_test

# Supabase (solo demo/staging; congelado desde el Sprint 26).
# El SERVICE_KEY es secreto y solo lo usa el backend. La anon key NO debe
# llegar nunca aquí ni al frontend para las RPCs del chat.
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOi...

# ── Proveedor de LLM ──────────────────────────────────────────────
# Hoy: Groq (pruebas). Mañana: OpenAI / Mistral / vLLM local con
# solo cambiar LLM_BASE_URL, LLM_MODEL y LLM_API_KEY.
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=gsk_...

# Alternativa local Google AI Studio (sin ADC/Vertex):
# El mismo endpoint OpenAI-compatible sirve chat y embeddings.
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-3.1-flash-lite
# LLM_API_KEY=TU_GEMINI_API_KEY
#
# Vertex AI (producción): además de LLM_PROVIDER=vertex-ai,
# GOOGLE_CLOUD_PROJECT y GOOGLE_CLOUD_LOCATION, el contenedor necesita
# GOOGLE_APPLICATION_CREDENTIALS_JSON o un archivo ADC montado.
# GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account",...}
#
# Para el overlay docker-compose.vertex.yml, ruta absoluta al JSON de
# service account en el host (no se versiona):
# GCP_SA_FILE=/etc/woll/gcp-sa.json

# Límite duro de tokens para la respuesta final (el orquestador hace
# hasta ORCHESTRATOR_MAX_ITERATIONS + 1 llamadas al LLM).
# Groq free tier: 8000 TPM. Con 1024 tokens de salida y 1 ronda de
# tools (2 llamadas en total) el ciclo cabe holgadamente.
# Si subes ORCHESTRATOR_MAX_ITERATIONS, reduce este valor para no
# agotar el TPM del proveedor.
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.7

# Concurrencia del LLM por instancia (bloque concurrencia 20-50).
# En Vercel el límite real es N × instancias. Si la cola se llena, el
# chat responde 503 con Retry-After.
LLM_MAX_CONCURRENCY=4
LLM_MAX_QUEUE=20
LLM_QUEUE_TIMEOUT_MS=15000

# ── Orquestador ───────────────────────────────────────────────────
# Presupuesto de tiempo del orquestador (ms). Vercel Hobby = 10s por
# Function. Dejamos margen para 2-3 llamadas a LLM + RPCs.
ORCHESTRATOR_BUDGET_MS=8000

# Rondas de tool-calling antes de la síntesis forzada.
# Mínimo 1 (menos de 1 lanza error al arrancar).
# Con Groq free (TPM bajo), dejar en 1 evita agotar la cuota.
# Con proveedores sin restricción de TPM, subir a 2-3.
ORCHESTRATOR_MAX_ITERATIONS=1

# Log de diagnóstico del orquestador (iteraciones, tool_calls, errores).
# 1 = activado, 0 = desactivado. Solo para desarrollo/debug;
# NO activar en producción.
ORCHESTRATOR_DEBUG=1

# 25-B: emite una línea JSON "chat.timing" por request con la latencia
# por etapa (clasificador, L1/L2, tools). Default 0; usar solo para medir
# o en una corrida del golden set.
CHAT_TIMING_ENABLED=0

# Caché en memoria del catálogo de capas (`chat_catalog`). Default 5 min.
CHAT_CATALOG_TTL_MS=300000

# ── Chat IA — Modo de respuesta ──────────────────────────────────
# Controla si el LLM puede mencionar tools, layer_ids y términos
# técnicos en la respuesta al usuario.
#
#   CHAT_VERBOSE=1 → modo desarrollo. El LLM puede mencionar
#                    herramientas, layer_ids, columnas de BD.
#                    Útil para debug.
#
#   CHAT_VERBOSE=0 → modo producción (recomendado). El LLM habla
#                    solo en lenguaje natural, sin jerga técnica.
#
# Déjalo en 0 en Vercel. Usa 1 solo en .env local durante desarrollo.
CHAT_VERBOSE=1

# ── Chat IA — Geometría en respuestas ────────────────────────────
# Controla si el chat puede adjuntar geometrías a la respuesta
# (FeatureCollection para pintar en el mapa).
#
#   CHAT_GEOJSON_ENABLED=1 → permitido (default)
#   CHAT_GEOJSON_ENABLED=0 → siempre devuelve geojson: null
#
# Es un killswitch: si el payload crece demasiado o hay problemas
# de performance, se apaga sin redeploy del código.
CHAT_GEOJSON_ENABLED=1

# Fallback de modelo (mismo proveedor, otro modelo)
# Se usa si el modelo principal falla con 503/timeout.
LLM_FALLBACK_ENABLED=0
LLM_FALLBACK_MODEL=

# ── Router determinístico (40-C.2) ──
CHAT_ROUTER_ENABLED=0
CHAT_ROUTER_MIN_CONFIDENCE=0.7

# ── Datos no disponibles (40-D.2) ──
# 0 = no detectar (comportamiento actual, recomendado mientras no haya más datos).
# 1 = agregar una línea al notice cuando la pregunta pide un dato que el visor no tiene.
CHAT_UNAVAILABLE_ENABLED=0

# ── Golden set (40-D.3) ──
# Variables que afectan el resultado del golden set.
# El runner las imprime en el header para que la corrida sea reproducible.
# CHAT_ROUTER_ENABLED=1
# CHAT_UNAVAILABLE_ENABLED=1

# ── Contexto de la petición (Sprint 23-C) ──
# Proveedor de hosting para leer la IP y el país del cliente.
# Valores: vercel | cloudflare | none
# Demo Vercel: vercel. VPS detrás de Nginx: none.
# Si no se configura, se asume "vercel".
GEO_PROVIDER=vercel

# Cuántos proxies hay antes del backend. Se usa para contar desde la
# DERECHA de x-forwarded-for (evita que un cliente falsifique la IP).
# Vercel: 2 (CDN + edge). Nginx en el VPS: 1. Sin proxy: 0.
TRUST_PROXY_HOPS=2

# Lista separada por comas de orígenes permitidos para CORS.
# Si no se configura, usa los defaults del código.
# Incluir el dominio del VPS y los orígenes locales de Nginx/Vercel.
ALLOWED_ORIGINS=https://visor.example.cl,https://wollatacamapruebas.vercel.app,http://localhost:8080,http://localhost:8099,http://localhost:3000

# ── Topes de costo (Sprint 23-E) ──
# 0 = apagar el chat (responde 503 sin llamar al LLM).
# 1 (default) = encendido.
CHAT_ENABLED=1

# Tope diario de requests al LLM. Si se alcanza, responde 503.
# 0 = sin tope (no recomendado en producción).
# Se resetea a las 00:00 UTC.
LLM_DAILY_REQUEST_CAP=0

# ── History (Sprint 23-D) ──
# Máximo de turnos de historial que se envían al LLM.
# 6 = 3 pares user-assistant.
MAX_HISTORY_TURNS=6

# ── RAG — Ingesta de documentos (Sprint 17) ───────────────────────
# Solo los lee scripts/ingest_docs.mjs. En el Sprint 18, EMBEDDINGS_*
# también lo necesitará el runtime del chat para embeber la pregunta.
#
# RAG_DATABASE_URL: conexión directa a PostgreSQL (NO la API REST de
# Supabase). Usa un rol de mínimo privilegio (rag_ingest) miembro de
# rag_writer. DATABASE_URL queda reservada para la API (woll_api).
# RAG_DATABASE_URL=postgres://rag_ingest:CAMBIAR@127.0.0.1:5432/woll
#
# Proveedor compatible con OpenAI /embeddings (OpenAI, vLLM, TEI, Ollama).
EMBEDDINGS_PROVIDER=openai-compatible
EMBEDDINGS_BASE_URL=http://127.0.0.1:8080/v1
EMBEDDINGS_MODEL=BAAI/bge-m3
EMBEDDINGS_API_KEY=
#
# Google AI Studio (OpenAI-compatible) para RAG local:
# EMBEDDINGS_PROVIDER=openai-compatible
# EMBEDDINGS_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# EMBEDDINGS_MODEL=gemini-embedding-2
# EMBEDDINGS_API_KEY=TU_GEMINI_API_KEY
# EMBEDDINGS_DIM=1024
# EMBEDDINGS_SEND_DIMENSIONS=1
# Fijado por rag.chunks.embedding vector(1024). Cambiarlo exige migración
# nueva y re-ingesta total.
EMBEDDINGS_DIM=1024
# 1 solo para modelos que aceptan dimensions=1024 (text-embedding-3-*).
EMBEDDINGS_SEND_DIMENSIONS=0
EMBEDDINGS_TIMEOUT_MS=30000
EMBEDDINGS_MAX_RETRIES=5
# Informativo: costo estimado en --dry-run. 0 si es autoalojado.
EMBEDDINGS_PRICE_PER_MTOK=0

RAG_EMBED_BATCH=32
RAG_CHUNK_TOKENS=450
RAG_CHUNK_OVERLAP=60
RAG_MAX_PDF_MB=25
RAG_MAX_PAGES=300
RAG_MIN_CHARS_PER_PAGE=80
# Activa trazas cortas en fallos inesperados del CLI (nunca contenido).
RAG_DEBUG=0

# Test de integración del pipeline (se salta si no está definido).
# RAG_TEST_DATABASE_URL=postgres://postgres@127.0.0.1:5432/woll_test

# ── Proxy de servicios externos (Sprint 17 / integraciones) ───────
# `/api/proxy` inyecta el INSTANCE_ID en el servidor: el navegador nunca
# lo ve. Acepta COPERNICUS_INSTANCE_ID o INSTANCE_ID (compatibilidad).
COPERNICUS_INSTANCE_ID=
# INSTANCE_ID=

# Cliente OAuth: solo si se usa Statistical API u ODP desde el backend.
# Nunca exponer CLIENT_SECRET al frontend.
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# Límites del proxy (en Vercel son por instancia; en el VPS se pueden
# reforzar con Nginx/Redis).
PROXY_RATE_LIMIT_PER_MIN=600
PROXY_RATE_LIMIT_BURST=120
PROXY_TIMEOUT_MS=25000

# Proxy persistente para desarrollo local (npm run dev:proxy).
# Evita que vercel dev ejecute una Function por tile.
PROXY_PORT=3001
PROXY_DEV_CONCURRENCY=6