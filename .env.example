# =====================================================================
# Plataforma Territorial Water Oriented Living Lab Atacama
# Variables de entorno — copia este archivo como .env y completa los
# valores. .env está en .gitignore (NUNCA subirlo al repositorio).
# =====================================================================

# ── Proveedor de base de datos ────────────────────────────────────
# Driver intercambiable: hoy "supabase", mañana "postgres" o "mysql".
DB_DRIVER=supabase

# Supabase (REST + PostGIS). El SERVICE_KEY es secreto y solo lo usa
# el backend en Vercel Functions. La anon key NO debe llegar nunca aquí
# ni al frontend para las RPCs del chat (grants: solo service_role).
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOi...

# ── Proveedor de LLM ──────────────────────────────────────────────
# Hoy: Groq (pruebas). Mañana: OpenAI / Mistral / vLLM local con
# solo cambiar LLM_BASE_URL, LLM_MODEL y LLM_API_KEY.
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=gsk_...

# Límite duro de tokens para la respuesta final (el orquestador hace
# hasta ORCHESTRATOR_MAX_ITERATIONS + 1 llamadas al LLM).
# Groq free tier: 8000 TPM. Con 1024 tokens de salida y 1 ronda de
# tools (2 llamadas en total) el ciclo cabe holgadamente.
# Si subes ORCHESTRATOR_MAX_ITERATIONS, reduce este valor para no
# agotar el TPM del proveedor.
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.7

# ── Orquestador ───────────────────────────────────────────────────
# Presupuesto de tiempo del orquestador (ms). Vercel Hobby = 10s por
# Function. Dejamos margen para 2-3 llamadas a LLM + RPCs.
ORCHESTRATOR_BUDGET_MS=8000

# Rondas de tool-calling antes de la síntesis forzada.
# Mínimo 1 (menos de 1 lanza error al arrancar).
# Con Groq free (TPM bajo), dejar en 1 evita agotar la cuota.
# Con proveedores sin restricción de TPM, subir a 2-3.
ORCHESTRATOR_MAX_ITERATIONS=1

# Log de diagnóstico del orquestador (iteraciones, tool_calls, errores).
# 1 = activado, 0 = desactivado. Solo para desarrollo/debug;
# NO activar en producción.
ORCHESTRATOR_DEBUG=1

# ── Chat IA — Modo de respuesta ──────────────────────────────────
# Controla si el LLM puede mencionar tools, layer_ids y términos
# técnicos en la respuesta al usuario.
#
#   CHAT_VERBOSE=1 → modo desarrollo. El LLM puede mencionar
#                    herramientas, layer_ids, columnas de BD.
#                    Útil para debug.
#
#   CHAT_VERBOSE=0 → modo producción (recomendado). El LLM habla
#                    solo en lenguaje natural, sin jerga técnica.
#
# Déjalo en 0 en Vercel. Usa 1 solo en .env local durante desarrollo.
CHAT_VERBOSE=1

# ── Chat IA — Geometría en respuestas ────────────────────────────
# Controla si el chat puede adjuntar geometrías a la respuesta
# (FeatureCollection para pintar en el mapa).
#
#   CHAT_GEOJSON_ENABLED=1 → permitido (default)
#   CHAT_GEOJSON_ENABLED=0 → siempre devuelve geojson: null
#
# Es un killswitch: si el payload crece demasiado o hay problemas
# de performance, se apaga sin redeploy del código.
CHAT_GEOJSON_ENABLED=1

# Fallback de modelo (mismo proveedor, otro modelo)
# Se usa si el modelo principal falla con 503/timeout.
LLM_FALLBACK_ENABLED=0
LLM_FALLBACK_MODEL=

# ── Router determinístico (40-C.2) ──
CHAT_ROUTER_ENABLED=0
CHAT_ROUTER_MIN_CONFIDENCE=0.7

# ── Datos no disponibles (40-D.2) ──
# 0 = no detectar (comportamiento actual, recomendado mientras no haya más datos).
# 1 = agregar una línea al notice cuando la pregunta pide un dato que el visor no tiene.
CHAT_UNAVAILABLE_ENABLED=0

# ── Golden set (40-D.3) ──
# Variables que afectan el resultado del golden set.
# El runner las imprime en el header para que la corrida sea reproducible.
# CHAT_ROUTER_ENABLED=1
# CHAT_UNAVAILABLE_ENABLED=1

# ── Contexto de la petición (Sprint 23-C) ──
# Proveedor de hosting para leer la IP y el país del cliente.
# Valores: vercel | cloudflare | none
# Si no se configura, se asume "vercel".
GEO_PROVIDER=vercel

# Cuántos proxies hay antes del backend. Se usa para contar desde la
# DERECHA de x-forwarded-for (evita que un cliente falsifique la IP).
# Vercel: 2 (CDN + edge). Cloudflare: 1. Sin proxy: 0 (usa x-real-ip).
TRUST_PROXY_HOPS=2

# Lista separada por comas de orígenes permitidos para CORS.
# Si no se configura, usa los defaults del código.
ALLOWED_ORIGINS=https://wollatacamapruebas.vercel.app,http://localhost:8099,http://localhost:3000

# ── Topes de costo (Sprint 23-E) ──
# 0 = apagar el chat (responde 503 sin llamar al LLM).
# 1 (default) = encendido.
CHAT_ENABLED=1

# Tope diario de requests al LLM. Si se alcanza, responde 503.
# 0 = sin tope (no recomendado en producción).
# Se resetea a las 00:00 UTC.
LLM_DAILY_REQUEST_CAP=0

# ── History (Sprint 23-D) ──
# Máximo de turnos de historial que se envían al LLM.
# 6 = 3 pares user-assistant.
MAX_HISTORY_TURNS=6