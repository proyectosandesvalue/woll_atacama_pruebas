# Dependencias
node_modules/

# Seguridad — credenciales de IA y Supabase
.env
.env.*
!.env.example
!.env.backup.example

# Vercel
.vercel/

# Sistema (macOS / Windows)
.DS_Store
._*
Thumbs.db

# OpenCode / agente local — no es parte del proyecto
.opencode/
.agents/
session_export.md
skills-lock.json

# Backups locales generados durante desarrollo
*.bak
*.bak.js

# Logs
*.log
npm-debug.log*

# Editores
.vscode/
.idea/
*.swp
*.swo

# Data
data/

# RAG — los PDFs fuente no se versionan; sí el manifiesto
rag/inbox/*
!rag/inbox/.gitkeep
rag/**/*.pdf

# Dumps/backups locales (nunca se versionan)
backups/
*.dump
*.dump.sha256

# Credenciales locales (service accounts, claves)
secrets/
*gcp*.json
*service-account*.json

# GeoJSON subidos desde el panel admin (Sprint 47)
geojson/uploads/

# Shapefiles ZIP privados subidos desde el panel (Sprint 47-D)
geojson/private/

# Tiles MVT pregenerados (se generan con npm run tiles:build; no se versionan)
tiles/

# Tiles ráster pregenerados (Sprint 49; se generan con npm run raster:publish)
raster/

# Configuración de backups (26-G)
.env.backup
