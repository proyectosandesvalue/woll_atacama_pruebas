# Backup PostgreSQL (Sprint 26-G)
# Copiar a /srv/woll/.env.backup con permisos 600 y completar secretos.

# Directorio local de backups (fuera del repo).
BACKUP_DIR=/var/backups/woll
BACKUP_RETENTION_DAYS=14
BACKUP_MIN_KEEP=3

# Cifrado: usar recipient GPG o passphrase, nunca ambos en el repo.
# BACKUP_GPG_RECIPIENT=backup@example.org
BACKUP_GPG_PASSPHRASE_FILE=/etc/woll/backup.pass

# Copia externa: directorio montado o comando (rclone/rsync).
# BACKUP_OFFSITE_DIR=/mnt/backup-externo/woll
BACKUP_OFFSITE_CMD='rclone copyto "$BACKUP_FILE" "woll-backups:$(basename "$BACKUP_FILE")"'

# Alerta si falla (recibe BACKUP_MESSAGE).
BACKUP_ALERT_CMD='logger -t woll-backup "$BACKUP_MESSAGE"'

# Contenedor de PostgreSQL para pg_dump/pg_restore.
# Verificar el nombre con `docker compose ps`.
PGUSER=postgres
PGDATABASE=woll
BACKUP_PG_CONTAINER=woll-postgres-1

# Opcional: si pg_dump está instalado en el host, usar la URL en vez del contenedor.
# DATABASE_ADMIN_URL=postgres://postgres:CLAVE@127.0.0.1:5432/woll
