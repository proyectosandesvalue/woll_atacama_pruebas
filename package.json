{
  "name": "plataforma-woll-atacama",
  "version": "2.1.0",
  "description": "Plataforma Territorial Water Oriented Living Lab Atacama",
  "main": "js/app.js",
  "type": "module",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "lint": "eslint js/ server/",
    "lint:fix": "eslint js/ server/ --fix",
    "test": "bash -c 'shopt -s globstar && node --test server/**/*.test.js'",
    "catalog": "node --env-file=.env.staging scripts/build_catalog.mjs",
    "smoke:db": "node --env-file=.env.staging scripts/smoke-db.mjs",
    "smoke:chat": "node --env-file=.env.staging scripts/smoke-orchestrator.mjs",
    "eval:chat": "node --env-file=.env.staging scripts/run-golden-set.mjs --all",
    "audit": "node --env-file=.env.staging scripts/audit-data.mjs",
    "audit:layer": "node --env-file=.env.staging scripts/audit-data.mjs --layer"
  },
  "devDependencies": {
    "eslint": "^8.57.0"
  },
  "dependencies": {
    "@google-cloud/vertexai": "^1.12.0",
    "@vercel/functions": "^3.10.1",
    "csv-parser": "^3.2.1",
    "google-auth-library": "^11.3.0"
  }
}
