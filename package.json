{
  "name": "plataforma-woll-atacama",
  "version": "2.1.0",
  "description": "Plataforma Territorial Water Oriented Living Lab Atacama",
  "main": "js/app.js",
  "type": "module",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "lint": "eslint js/ server/",
    "lint:fix": "eslint js/ server/ --fix",
    "test": "bash -c 'shopt -s globstar && node --test server/**/*.test.js'",
    "catalog": "node --env-file=.env.staging scripts/build_catalog.mjs",
    "smoke:db": "node --env-file=.env.staging scripts/smoke-db.mjs",
    "smoke:chat": "node --env-file=.env.staging scripts/smoke-orchestrator.mjs",
    "eval:chat": "node --env-file=.env.staging scripts/run-golden-set.mjs --all",
    "audit": "node --env-file=.env.staging scripts/audit-data.mjs",
    "audit:layer": "node --env-file=.env.staging scripts/audit-data.mjs --layer",
    "ingest:dry": "node scripts/ingest_docs.mjs --dry-run",
    "ingest": "node --env-file=.env.local scripts/ingest_docs.mjs",
    "migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "migrate:status": "node --env-file=.env.local scripts/migrate.mjs --status",
    "check:rpcs": "node --env-file=.env.local scripts/check-rpc-signatures.mjs",
    "db:dump": "./scripts/dump-supabase.sh",
    "db:restore": "./scripts/restore-local.sh",
    "db:verify": "node scripts/verify-migration.mjs",
    "db:extract-rpcs": "node scripts/extract-legacy-rpcs.mjs",
    "layer:load": "node --env-file=.env.local scripts/load-layer.mjs",
    "db:up": "docker compose --env-file .env.local -f docker-compose.yml -f docker-compose.dev.yml up -d postgres",
    "db:down": "docker compose --env-file .env.local -f docker-compose.yml -f docker-compose.dev.yml down",
    "stack:up": "docker compose --env-file .env.local -f docker-compose.yml -f docker-compose.dev.yml up -d",
    "stack:down": "docker compose --env-file .env.local -f docker-compose.yml -f docker-compose.dev.yml down",
    "stack:logs": "docker compose --env-file .env.local -f docker-compose.yml -f docker-compose.dev.yml logs -f --tail=100",
    "dev:proxy": "node --env-file=.env.staging scripts/dev-proxy.mjs",
    "dev:api": "node --env-file=.env.local --watch server/index.js",
    "start": "node server/index.js",
    "dev": "bash scripts/dev.sh"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "pdfjs-dist": "^4.10.38"
  },
  "dependencies": {
    "@google-cloud/vertexai": "^1.12.0",
    "@vercel/functions": "^3.10.1",
    "csv-parser": "^3.2.1",
    "google-auth-library": "^11.3.0",
    "pg": "^8.23.1"
  }
}
