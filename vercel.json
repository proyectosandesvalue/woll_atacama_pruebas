{
  "version": 2,
  "functions": {
    "api/chat.js": {
      "maxDuration": 300,
      "excludeFiles": "{geojson/**,db/**,scripts/**,docs/**,rag/**,help.html,session_export.md,skills-lock.json}"
    },
    "api/proxy.js": {
      "maxDuration": 60,
      "excludeFiles": "{geojson/**,db/**,scripts/**,docs/**,rag/**,js/**,css/**,assets/**,help.html,index.html,session_export.md,skills-lock.json}"
    }
  },
  "rewrites": [
    {
      "source": "/api/chat/info",
      "destination": "/api/chat-info.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1.js"
    },
    {
      "source": "/visor",
      "destination": "/index.html"
    },
    {
      "source": "/chat",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/visor/",
      "destination": "/visor",
      "permanent": true
    },
    {
      "source": "/chat/",
      "destination": "/chat",
      "permanent": true
    }
  ]
}
