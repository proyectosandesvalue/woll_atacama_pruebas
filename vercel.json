{
  "version": 2,
  "functions": {
    "api/**/*.js": {
      "excludeFiles": "{geojson/**,db/**,scripts/**,docs/**,help.html,session_export.md,skills-lock.json}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1.js"
    }
  ],
  "functions": {
    "api/chat.js": {
      "maxDuration": 60
    }
  }
}
